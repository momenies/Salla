# ═══════════════════════════════════════════════════════════════════════════
#  انسخ هذا الملف باسم .env واملأ القيم — ولا ترفع .env الحقيقي إلى Git أبداً
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────── مفاتيح سلة (إلزامية للدخول) ───────────────────────
# من بوابة شركاء سلة: partners.salla.dev ← تطبيقك ← مفاتيح التطبيق
SALLA_OAUTH_CLIENT_ID=
SALLA_OAUTH_CLIENT_SECRET=
# رابط الرجوع — محلياً: http://localhost:8082/oauth/callback
SALLA_OAUTH_CLIENT_REDIRECT_URI=
# سرّ الأحداث من تبويب الويبهوك (إلزامي في الإنتاج)
SALLA_WEBHOOK_SECRET=
# معرّف التطبيق في متجر تطبيقات سلة — يُستخدم في روابط الشراء بصفحة الباقات
SALLA_APP_ID=
# طريقة تحقّق الويبهوك: auto (افتراضي) | token | signature
SALLA_WEBHOOK_STRATEGY=auto

# ─────────────────────── الأمان (إلزامي في الإنتاج) ────────────────────────
# سرّ توقيع الجلسات. ولّده بأمر: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# بدونه يرفض التطبيق الإقلاع في الإنتاج — سرّ ثابت معروف = تزوير جلسات التجار.
SESSION_SECRET=
# عمر الجلسة بالأيام (افتراضي 14)
SESSION_DAYS=14
# اجعله 1 خلف موازن أحمال أو وسيط (Cloud Run / Nginx)
TRUST_PROXY=

# ─────────────────────── قاعدة البيانات ────────────────────────────────────
# الافتراضي: ملف SQLite محلي بصفر إعدادات
DATABASE_STORAGE=database.sqlite
# للإنتاج، استخدم رابطاً كاملاً بدلاً منه (Postgres أو MySQL):
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# أو المتغيّرات المنفصلة:
# DATABASE_SERVER=127.0.0.1
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# DATABASE_NAME=
# DATABASE_DIALECT=mysql
# DATABASE_POOL_MAX=10
# DATABASE_LOG=0

# ─────────────────────── التشغيل ───────────────────────────────────────────
PORT=8082
NODE_ENV=development
# سرّ مسار المجدول /internal/cron/<secret> — أي نص عشوائي طويل
CRON_SECRET=
# اجعله 1 حين يتولّى مجدول خارجي (Cloud Scheduler) تشغيل الدورات
DISABLE_INTERNAL_TICKER=
# المنطقة الزمنية لحساب ساعات الهدوء والتقارير
APP_TIMEZONE=Asia/Riyadh
# مستوى السجل: debug | info | warn | error
LOG_LEVEL=

# ─────────────────────── اختياري ───────────────────────────────────────────
# رابط التطبيق العام بعد النشر
PUBLIC_URL=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
# إصدار واجهة Meta (الافتراضي v21.0)
META_GRAPH_VERSION=
# مجلد جلسات ربط الباركود
WWEB_SESSIONS_DIR=
# مسار Chromium إن أردت تفعيل قناة الباركود بمتصفّح مثبّت مسبقاً
CHROMIUM_PATH=

# ─────────────────────── وضع التجربة ───────────────────────────────────────
# يفتح كل الميزات المدفوعة بلا شراء — للتطوير المحلي فقط.
# يُتجاهَل قسراً حين NODE_ENV=production، ويظهر شريط تحذير في كل صفحة.
UNLOCK_ALL_FEATURES=false
