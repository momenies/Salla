# انسخ هذا الملف باسم .env واملأ القيم — لا ترفع .env الحقيقي أبداً إلى Git

# بيانات التطبيق من بوابة شركاء سلة (partners.salla.dev)
SALLA_OAUTH_CLIENT_ID=
SALLA_OAUTH_CLIENT_SECRET=
# رابط الرجوع بعد تسجيل الدخول — محلياً: http://localhost:8082/oauth/callback
SALLA_OAUTH_CLIENT_REDIRECT_URI=
# سر الـ Webhooks من بوابة الشركاء
SALLA_WEBHOOK_SECRET=

# قاعدة البيانات المحلية (SQLite — صفر إعدادات)
DATABASE_STORAGE=database.sqlite

# سر مجدول الأتمتة (أي نص عشوائي طويل) — يحمي نقطة /internal/cron/:secret
CRON_SECRET=

# للإنتاج لاحقاً (Cloud Run): استبدل SQLite بـ MySQL عبر المتغيرات:
# DATABASE_SERVER=127.0.0.1
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# DATABASE_NAME=
