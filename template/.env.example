
# اسم التطبيق كما يظهر في الواجهة
APP_NAME=تطبيق سلة

# العنوان العام للتطبيق بعد النشر (يُستخدم لعرض رابط الويبهوك)
APP_URL=http://localhost:8082

# المنفذ — منصّات مثل Cloud Run تضبطه تلقائياً
PORT=8082

# سر تشفير الجلسات — غيّره إلى قيمة عشوائية طويلة قبل النشر
SESSION_SECRET=change-me-to-a-long-random-string

# oAuth2
SALLA_OAUTH_CLIENT_ID=000000000000000000000000000
SALLA_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx
SALLA_OAUTH_CLIENT_REDIRECT_URI=http://localhost:8081/oauth/callback
SALLA_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxx
SALLA_AUTHORIZATION_MODE=easy
SALLA_APP_ID=

# Database 
DATABASE_PASSWORD=test
DATABASE_USERNAME=test
DATABASE_SERVER=localhost
DATABASE_NAME=test
SALLA_DATABASE_ORM=Sequelize

# إعدادات الواجهة
UI_PER_PAGE=15
VAT_RATE=0.15
DEFAULT_CURRENCY=SAR

# قاعدة بيانات محلية (SQLite) — اتركها فارغة لاستخدام MySQL بدلاً منها
DATABASE_STORAGE=database.sqlite

# ─────────────────────────── الأتمتة (إرسال الرسائل) ───────────────────────────
AUTOMATION_ENABLED=true
# كل كم ثانية يفحص التطبيق صندوق الصادر
AUTOMATION_DISPATCH_INTERVAL_SEC=30
AUTOMATION_MAX_ATTEMPTS=4
DEFAULT_COUNTRY_CODE=966

# توكن يحمي /tasks/dispatch — اضبطه إن كنت تستخدم Cloud Scheduler
AUTOMATION_DISPATCH_TOKEN=

# قناة الربط الخارجي: يرسل الرسالة كـ JSON لأي خدمة (Make / Zapier / n8n / مزوّد SMS)
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=

# قناة واتساب الرسمية (WhatsApp Cloud API من Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# اسم قالب معتمد من Meta — مطلوب للإرسال خارج نافذة الـ٢٤ ساعة
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ar
